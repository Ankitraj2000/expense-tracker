# Git ignore rules for Expense Tracker

# ── Java / Maven ──────────────────────────────────────────────
target/
*.class
*.jar
*.war
*.ear
*.log
.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/
.idea/
*.iml
*.ipr
*.iws
.settings/
.classpath
.project

# ── Node / NPM ────────────────────────────────────────────────
node_modules/
dist/
.vite/
*.local

# ── Environment Files (NEVER commit secrets) ──────────────────
.env
.env.local
.env.production
.env.staging
*.env

# ── macOS ─────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride

# ── Windows ───────────────────────────────────────────────────
Thumbs.db
Desktop.ini

# ── IDE ───────────────────────────────────────────────────────
.vscode/
*.swp
*.swo
*.tmp

# ── Logs ──────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ────────────────────────────────────────────────────────
*.orig
*.rej
